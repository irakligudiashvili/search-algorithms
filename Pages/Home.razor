@page "/"
@using SearchAlgorithms.Models
@using SearchAlgorithms.Data
@using SearchAlgorithms.Services
@using System.Threading
@inject IterativeDeepeningBidirectionalDFS IdBiDfsEngine
@inject AStarSearch AStarEngine
@implements IDisposable

<PageTitle>Search Algorithms</PageTitle>

<div class="container-fluid text-white px-4 py-4" style="max-width: 1600px; min-height: 100vh; max-height:100vh; display: flex; flex-direction: column; font-family: system-ui, -apple-system, sans-serif;">
    <div style="max-width: 1500px; background: rgba(30, 34, 45, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); padding: 15px 30px; border-radius: 16px 16px 0 0; display: flex; gap: 28px; align-items: flex-end; justify-content: center; width: 100%; border: 1px solid rgba(255, 255, 255, 0.08); border-bottom: none; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35); flex-shrink: 0;">
        <div style="display: flex; flex-direction: row; gap: 8px; justify-content: center; align-items: center;">
            <label class="fw-bold small text-uppercase" style="letter-spacing: 1px; font-size: 10px; color: rgba(255,255,255,0.6);">Select Algorithm</label>
            <select @bind="SelectedAlgorithmKey" disabled="@IsSimulating" class="form-select text-white border-0" style="width: 180px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.07); padding: 10px 14px; font-size: 14px; cursor: pointer; transition: background-color 0.2s;">
                <option disabled selected value="">-- Select --</option>
                <option value="ID_BIDS">ID-Bidirectional DFS</option>
                <option value="ASTAR">A* Search</option>
            </select>
        </div>

        <div style="display: flex; flex-direction: row; gap: 8px; justify-content: center; align-items: center;">
            <label class="fw-bold small text-uppercase" style="letter-spacing: 1px; font-size: 10px; color: rgba(255,255,255,0.6);">Start Location</label>
            <select @bind="StartCity" disabled="@IsSimulating" class="form-select text-white border-0" style="width: 150px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.07); padding: 10px 14px; font-size: 14px; cursor: pointer; transition: background-color 0.2s;">
                <option disabled selected value="">-- Select --</option>
                @foreach (var city in GeorgiaMap.Cities.OrderBy(c => c.Name)) {
                    <option value="@city.Name">@city.Name</option>
                }
            </select>
        </div>

        <div style="display: flex; flex-direction: row; gap: 8px; justify-content: center; align-items: center;">
            <label class="fw-bold small text-uppercase" style="letter-spacing: 1px; font-size: 10px; color: rgba(255,255,255,0.6);">Target Destination</label>
            <select @bind="TargetCity" disabled="@IsSimulating" class="form-select text-white border-0" style="width: 150px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.07); padding: 10px 14px; font-size: 14px; cursor: pointer; transition: background-color 0.2s;">
                <option disabled selected value="">-- Select --</option>
                @foreach (var city in GeorgiaMap.Cities.OrderBy(c => c.Name)) {
                    <option value="@city.Name">@city.Name</option>
                }
            </select>
        </div>

        <div style="display: flex; flex-direction: row; gap: 10px; align-items: center; height: 41px; padding: 0 5px; user-select: none;">
            <input type="checkbox" id="sim-mode-checkbox" @bind="IsSimulationMode" disabled="@IsSimulating" style="width: 18px; height: 18px; cursor: pointer; accent-color: #007bff;" />
            <label for="sim-mode-checkbox" class="fw-bold small text-uppercase" style="letter-spacing: 0.5px; font-size: 11px; cursor: pointer; color: @(IsSimulationMode ? "#ffc107" : "rgba(255,255,255,0.6)"); transition: color 0.2s;">Simulation Mode</label>
        </div>

        <button class="btn btn-primary fw-bold px-4 text-uppercase" @onclick="RunSearch" 
        disabled="@(string.IsNullOrEmpty(StartCity) || string.IsNullOrEmpty(TargetCity) || string.IsNullOrEmpty(SelectedAlgorithmKey) || IsSimulating)"
        style="border-radius: 8px; background: linear-gradient(135deg, #007bff, #0052cc); border: none; height: 41px; font-size: 13px; letter-spacing: 0.5px; transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(0, 123, 255, 0.25);">
            Find Path
        </button>
    </div>

    <div style="max-width: 1500px; background: #1a1a1a; min-height: 65px; max-height: 65px; border-left: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #222; display: flex; align-items: center; justify-content: center; width: 100%; flex-shrink: 0; box-shadow: inset 0 1px 3px rgba(255,255,255,0.02);">
        @if (Result != null) {
            <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-around; width: 100%; gap: 16px; text-align: center; padding: 0 24px;">
                <div style="display: flex; flex-direction: column; gap: 2px; flex: 1;">
                    <span class="small fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 11px; color: #aaa;">Explored Nodes</span>
                    <strong style="font-size: 22px; color: #ffc107; font-family: monospace; font-weight: 700; line-height: 1;">@Result.NodesExploredCount</strong>
                </div>

                <div style="height: 32px; width: 1px; background-color: rgba(255,255,255,0.15);"></div>

                <div style="display: flex; flex-direction: column; gap: 2px; flex: 1;">
                    <span class="small fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 11px; color: #aaa;">Execution Performance</span>
                    <strong style="font-size: 22px; color: #0dcaf0; font-family: monospace; font-weight: 700; line-height: 1;">@Result.ExecutionTime.TotalMilliseconds.ToString("F3")<span style="font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.3); margin-left: 2px;">ms</span></strong>
                </div>

                <div style="height: 32px; width: 1px; background-color: rgba(255,255,255,0.15);"></div>

                <div style="display: flex; flex-direction: column; gap: 2px; flex: 1;">
                    <span class="small fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 11px; color: #aaa;">Calculated Weight</span>
                    <strong style="font-size: 22px; color: #22c97e; font-family: monospace; font-weight: 700; line-height: 1;">@Result.TotalDistance.ToString("F1")<span style="font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.3); margin-left: 2px;">km</span></strong>
                </div>
            </div>
        }
    </div>

    <div style="flex: 3; min-width: 600px; background-color: #111317; max-width: 1500px; max-height: 800px; border: 1px solid rgba(255,255,255,0.08); border-radius: 0 0 12px 12px; overflow: hidden; aspect-ratio: 1920 / 1023; box-shadow: 0 12px 40px rgba(0,0,0,0.55);">
        <svg id="map-svg"
        width="100%" height="100%"
        viewBox="0 0 @MapWidth @MapHeight"
        preserveAspectRatio="xMidYMid slice"
        @ref="SvgContainerReference"
        @onpointerdown="HandleMapPointerDown"
        @onpointermove="HandleMapPointerMove"
        @onpointerup="HandleMapPointerUp"
        @onpointerleave="HandleMapPointerUp"
        @onwheel="HandleWheel"
        @onwheel:preventDefault="true"
        style="display:block; cursor: @(IsPanning ? "grabbing" : "grab"); touch-action: none;">

            <defs>
                <filter id="f-glow-cyan" x="-80%" y="-80%" width="260%" height="260%">
                    <feGaussianBlur stdDeviation="14" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <filter id="f-glow-green" x="-80%" y="-80%" width="260%" height="260%">
                    <feGaussianBlur stdDeviation="10" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <filter id="f-glow-yellow" x="-80%" y="-80%" width="260%" height="260%">
                    <feGaussianBlur stdDeviation="7" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
                <radialGradient id="g-vignette" cx="50%" cy="50%" r="70%">
                    <stop offset="0%" stop-color="#000" stop-opacity="0" />
                    <stop offset="100%" stop-color="#000" stop-opacity="0.6" />
                </radialGradient>
            </defs>

            <g transform="translate(@PanX, @PanY) scale(@ZoomScale)" transform-origin="0 0">

                <image href="images/georgia.png" width="@MapWidth" height="@MapHeight" x="0" y="0" style="filter: contrast(1.08) brightness(0.78) saturate(0.9); pointer-events: none;" />
                <rect width="@MapWidth" height="@MapHeight" fill="#080c18" opacity="0.38" style="pointer-events:none;" />
                <rect width="@MapWidth" height="@MapHeight" fill="url(#g-vignette)" style="pointer-events:none;" />

                @foreach (var road in GeorgiaMap.Roads) {
                    var cityA = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.StartCity);
                    var cityB = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.EndCity);
                    if (cityA != null && cityB != null) {
                        var posA = Project(cityA);
                        var posB = Project(cityB);

                        bool isFinalShortestPath = IsRoadInPath(road.StartCity, road.EndCity);
                        bool isExploredStatic = Result?.VisitedOrder?.Contains(road.StartCity) == true && Result?.VisitedOrder?.Contains(road.EndCity) == true;
                        var activeAnim = ActiveRoadAnimations.FirstOrDefault(a => a.RoadRef == road);

                        if (!isFinalShortestPath || IsSimulating) {
                            <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="7" stroke-linecap="round" style="pointer-events:none;" />
                            <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="rgba(255,255,255,0.13)" stroke-width="2.5" stroke-linecap="round" style="pointer-events:none;" />
                        }

                        if (activeAnim != null || (!IsSimulating && isExploredStatic) || (isFinalShortestPath && !IsSimulating)) {
                            double progress = activeAnim != null ? activeAnim.Progress : 1.0;
                            bool inverted = activeAnim?.IsInverted ?? false;

                            var (x1, y1) = inverted ? (posB.X, posB.Y) : (posA.X, posA.Y);
                            var (x2, y2) = inverted ? (posA.X, posA.Y) : (posB.X, posB.Y);
                            double totalPixelLength = GetBezierPixelLength(x1, y1, road.ControlX, road.ControlY, x2, y2);

                            string coreColor = isFinalShortestPath ? "#22c97e" : "rgba(230,210,40,0.35)";
                            string darkGlowColor = isFinalShortestPath ? "#0a3d25" : "rgba(230,210,40,0.15)";
                            string outerFilterColor = isFinalShortestPath ? "#22c97e" : "rgba(255,220,80,0.35)";
                            string filterUrl = isFinalShortestPath ? "url(#f-glow-green)" : "url(#f-glow-yellow)";

                            int baseThickness = isFinalShortestPath ? 4 : 3;
                            int backgroundThickness = isFinalShortestPath ? 22 : 10;
                            int inlineTrackThickness = isFinalShortestPath ? 7 : 3;
                            double structuralOpacity = isFinalShortestPath ? 0.08 : 0.35 * progress;

                            <path d="M @x1 @y1 Q @road.ControlX @road.ControlY @x2 @y2" fill="none" stroke="@darkGlowColor" stroke-width="@backgroundThickness" stroke-linecap="round" opacity="@structuralOpacity" filter="@(isFinalShortestPath ? "url(#f-glow-green)" : null)" style="pointer-events:none;" />
                            <path d="M @x1 @y1 Q @road.ControlX @road.ControlY @x2 @y2" fill="none" stroke="@(isFinalShortestPath ? "#0a3d25" : darkGlowColor)" stroke-width="@inlineTrackThickness" stroke-linecap="round" stroke-dasharray="@totalPixelLength" stroke-dashoffset="@(totalPixelLength * (1 - progress))" style="pointer-events:none;" />
                            <path d="M @x1 @y1 Q @road.ControlX @road.ControlY @x2 @y2" fill="none" stroke="@coreColor" stroke-width="@baseThickness" stroke-linecap="round" stroke-dasharray="@totalPixelLength" stroke-dashoffset="@(totalPixelLength * (1 - progress))" style="pointer-events:none;" />

                            if (isFinalShortestPath) {
                                <path d="M @x1 @y1 Q @road.ControlX @road.ControlY @x2 @y2" fill="none" stroke="#a8f0cc" stroke-width="1" stroke-linecap="round" stroke-dasharray="18 14" opacity="0.5" stroke-dashoffset="@(totalPixelLength * (1 - progress))" style="pointer-events:none;" />
                            } else {
                                <path d="M @x1 @y1 Q @road.ControlX @road.ControlY @x2 @y2" fill="none" stroke="@outerFilterColor" stroke-width="6" stroke-linecap="round" opacity="@progress" filter="@filterUrl" style="pointer-events:none;" />
                            }

                            if (IsSimulating && activeAnim != null) {
                                var (hx, hy) = GetBezierPoint(progress, x1, y1, road.ControlX, road.ControlY, x2, y2);
                                <circle cx="@hx" cy="@hy" r="5" fill="@(isFinalShortestPath ? "#a8f0cc" : "#ffd84a")" opacity="0.95" filter="url(#f-glow-yellow)" style="pointer-events:none;" />
                            }
                        }
                    }
                }

                @foreach (var road in GeorgiaMap.Roads) {
                    var cityA = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.StartCity);
                    var cityB = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.EndCity);
                    if (cityA != null && cityB != null && IsRoadInPath(road.StartCity, road.EndCity) && !IsSimulating) {
                        var posA = Project(cityA);
                        var posB = Project(cityB);
                        <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="#22c97e" stroke-width="22" stroke-linecap="round" opacity="0.08" style="pointer-events:none;" filter="url(#f-glow-green)" />
                        <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="#0a3d25" stroke-width="7" stroke-linecap="round" style="pointer-events:none;" />
                        <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="#22c97e" stroke-width="4" stroke-linecap="round" style="pointer-events:none;" />
                        <path d="M @posA.X @posA.Y Q @road.ControlX @road.ControlY @posB.X @posB.Y" fill="none" stroke="#a8f0cc" stroke-width="1" stroke-linecap="round" stroke-dasharray="18 14" opacity="0.5" style="pointer-events:none;" />
                    }
                }

                @foreach (var road in GeorgiaMap.Roads) {
                    var cityA = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.StartCity);
                    var cityB = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.EndCity);
                    if (cityA != null && cityB != null) {
                        var posA = Project(cityA);
                        var posB = Project(cityB);
                        bool isPath = IsRoadInPath(road.StartCity, road.EndCity) && !IsSimulating;
                        double hx = 0.25 * posA.X + 0.5 * road.ControlX + 0.25 * posB.X;
                        double hy = 0.25 * posA.Y + 0.5 * road.ControlY + 0.25 * posB.Y;

                        <circle cx="@hx" cy="@hy" r="18" fill="transparent" stroke="none" style="cursor:move; pointer-events: all;" @onpointerdown="(e) => HandleRoadHandleDown(e, road, cityA, cityB)" @onpointerdown:stopPropagation="true" />
                        <g class="road-handle" style="pointer-events: none;">
                            <circle cx="@hx" cy="@hy" r="12" fill="@(isPath ? "rgba(34,201,126,0.15)" : "rgba(255,255,255,0.08)")" stroke="@(isPath ? "rgba(34,201,126,0.55)" : "rgba(255,255,255,0.3)")" stroke-width="1.5" />
                            <circle class="road-handle-inner" cx="@hx" cy="@hy" r="4" fill="@(isPath ? "#22c97e" : "rgba(255,255,255,0.6)")" stroke="none" />
                            <line class="road-handle-inner" x1="@(hx - 7)" y1="@hy" x2="@(hx + 7)" y2="@hy" stroke="@(isPath ? "rgba(34,201,126,0.6)" : "rgba(255,255,255,0.35)")" stroke-width="1" />
                            <line class="road-handle-inner" x1="@hx" y1="@(hy - 7)" x2="@hx" y2="@(hy + 7)" stroke="@(isPath ? "rgba(34,201,126,0.6)" : "rgba(255,255,255,0.35)")" stroke-width="1" />
                        </g>
                    }
                }

                @foreach (var city in GeorgiaMap.Cities) {
                    var pos = Project(city);
                    bool isStart = city.Name == StartCity;
                    bool isEnd = city.Name == TargetCity;
                    bool isTerminal = isStart || isEnd;
                    bool isOnPath = Result?.Path?.Contains(city.Name) ?? false;
                    bool isExplored = Result?.VisitedOrder?.Contains(city.Name) ?? false;
                    bool searchRan = Result != null;
                    bool isDimmed = searchRan && !isTerminal && !isOnPath && !isExplored;

                    string nodeColor, ringColor, labelColor, bodyFill;
                    double nodeR, outerR;
                    string glowFilter;
                    bool showRing;

                    if (isTerminal) {
                        nodeColor = "#00edf1";
                        ringColor = "rgba(0,237,241,0.2)";
                        labelColor = "#00edf1";
                        bodyFill = "rgba(0,180,185,0.55)";
                        nodeR = 11;
                        outerR = 22;
                        glowFilter = "url(#f-glow-cyan)";
                        showRing = true;
                    } else if (isOnPath && searchRan && (!IsSimulating || isExplored)) {
                        nodeColor = "#22c97e";
                        ringColor = "rgba(34,201,126,0.2)";
                        labelColor = "#a8f0cc";
                        bodyFill = "rgba(34,180,100,0.55)";
                        nodeR = 8;
                        outerR = 16;
                        glowFilter = "url(#f-glow-green)";
                        showRing = true;
                    } else if (isExplored && searchRan) {
                        nodeColor = "#e6d620";
                        ringColor = "rgba(230,214,32,0.15)";
                        labelColor = "#f0e87a";
                        bodyFill = "rgba(200,185,20,0.55)";
                        nodeR = 6;
                        outerR = 13;
                        glowFilter = "url(#f-glow-yellow)";
                        showRing = true;
                    } else {
                        nodeColor = isDimmed ? "rgba(140,136,128,0.4)" : "rgba(180,175,168,0.9)";
                        ringColor = "transparent";
                        labelColor = isDimmed ? "rgba(160,156,148,0.4)" : "rgba(210,206,198,0.85)";
                        bodyFill = isDimmed ? "rgba(60,58,54,0.3)" : "rgba(55,52,48,0.75)";
                        nodeR = isDimmed ? 4.5 : 5;
                        outerR = 0;
                        glowFilter = "none";
                        showRing = false;
                    }

                    if (showRing) {
                        <circle cx="@pos.X" cy="@pos.Y" r="@outerR" fill="@ringColor" stroke="@nodeColor" stroke-width="@(isTerminal ? 1.5 : 1)" opacity="@(isTerminal ? 0.55 : 0.38)" style="pointer-events:none;" />
                    }
                    if (isTerminal) {
                        <circle cx="@pos.X" cy="@pos.Y" r="34" fill="none" stroke="rgba(0,237,241,0.09)" stroke-width="1" style="pointer-events:none;" />
                    }
                    if (glowFilter != "none") {
                        <circle cx="@pos.X" cy="@pos.Y" r="@nodeR" fill="@nodeColor" opacity="@(isTerminal ? 0.3 : 0.2)" filter="@glowFilter" style="pointer-events:none;" />
                    }
                    <circle cx="@pos.X" cy="@pos.Y" r="@nodeR" fill="@bodyFill" stroke="@nodeColor" stroke-width="@(isTerminal ? 2.5 : isOnPath && searchRan ? 2 : 1.5)" style="pointer-events:none;" />

                    double labelY = pos.Y - nodeR - (isTerminal ? 14 : 10);
                    double fontSize = isTerminal ? 21 : isOnPath && searchRan ? 17 : 15;
                    string fontWeight = isTerminal ? "700" : isOnPath && searchRan ? "600" : "500";

                    <svg:text x="@pos.X" y="@labelY" fill="rgba(0,0,0,0.95)" font-family="'Inter','Segoe UI',system-ui,sans-serif" font-size="@fontSize" font-weight="@fontWeight" text-anchor="middle" style="user-select:none; pointer-events:none; letter-spacing:0.3px;">@city.Name</svg:text>
                    <svg:text x="@pos.X" y="@labelY" fill="@labelColor" font-family="'Inter','Segoe UI',system-ui,sans-serif" font-size="@fontSize" font-weight="@fontWeight" text-anchor="middle" style="user-select:none; pointer-events:none; letter-spacing:0.3px; transform: translate(0px, -1px);">@city.Name</svg:text>
                }

            </g>

            <g style="pointer-events: none;">
                @{
                    double legendWidth = 236;
                    double legendHeight = 140;
                    double lx = MapWidth - legendWidth - 50;
                    double ly = MapHeight - legendHeight - 50;
                }

                <rect x="@lx" y="@ly" width="@legendWidth" height="@legendHeight" rx="6" fill="rgba(6,9,20,0.75)" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
                <text x="@(lx + 15)" y="@(ly + 21)" fill="rgba(255,255,255,0.3)" font-size="10" font-family="'Inter','Segoe UI',system-ui,sans-serif" font-weight="600" letter-spacing="2">LEGEND</text>

                <circle cx="@(lx + 22)" cy="@(ly + 43)" r="7" fill="rgba(0,180,185,0.55)" stroke="#00edf1" stroke-width="2" />
                <text x="@(lx + 38)" y="@(ly + 48)" fill="rgba(255,255,255,0.6)" font-size="13" font-family="'Inter','Segoe UI',system-ui,sans-serif">Origin / Target</text>

                <circle cx="@(lx + 22)" cy="@(ly + 70)" r="6" fill="rgba(34,180,100,0.55)" stroke="#22c97e" stroke-width="2" />
                <text x="@(lx + 38)" y="@(ly + 75)" fill="rgba(255,255,255,0.6)" font-size="13" font-family="'Inter','Segoe UI',system-ui,sans-serif">On path</text>

                <circle cx="@(lx + 22)" cy="@(ly + 97)" r="5" fill="rgba(200,185,20,0.55)" stroke="#e6d620" stroke-width="1.8" />
                <text x="@(lx + 38)" y="@(ly + 102)" fill="rgba(255,255,255,0.6)" font-size="13" font-family="'Inter','Segoe UI',system-ui,sans-serif">Explored</text>

                <circle cx="@(lx + 22)" cy="@(ly + 122)" r="4" fill="rgba(55,52,48,0.75)" stroke="rgba(180,175,168,0.9)" stroke-width="1.5" />
                <text x="@(lx + 38)" y="@(ly + 127)" fill="rgba(255,255,255,0.6)" font-size="13" font-family="'Inter','Segoe UI',system-ui,sans-serif">Inactive</text>

                <!-- Zoom text anchored to the exact bottom right corner margin -->
                <text x="@(MapWidth - 25)" y="@(MapHeight - 12)" fill="rgba(255,255,255,0.25)" font-size="13" font-family="'Inter','Segoe UI',system-ui,sans-serif" text-anchor="end">@((ZoomScale * 100).ToString("F0"))%</text>
            </g>

        </svg>
    </div>
</div>

<style>
    .road-handle {
    opacity: 0;
    transition: opacity 0.2s ease;
    }

    svg:hover .road-handle {
    opacity: 1;
    }

    .road-handle-inner {
    pointer-events: none;
    }
    
    .form-select option {
        background-color: #212529;
        color: #fff;
    }
    
    .form-select:hover {
        background-color: rgba(255, 255, 255, 0.12) !important;
    }
    
    .form-select:focus {
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25);
        background-color: rgba(255, 255, 255, 0.07) !important;
    }
</style>


@code{
    private int MapWidth = 1920;
    private int MapHeight = 1023;

    private double MinLon = 39.8;
    private double MaxLon = 46.9;
    private double MinLat = 40.9;
    private double MaxLat = 43.7;

    private string SelectedAlgorithmKey { get; set; }
    private string StartCity { get; set; } = "";
    private string TargetCity { get; set; } = "";
    private SearchResult Result { get; set; }
    private string ActiveEngineName { get; set; } = "";

    private Road SelectedDraggingRoad { get; set; }
    private City AssociatedCityA { get; set; }
    private City AssociatedCityB { get; set; }

    private ElementReference SvgContainerReference;

    private double ZoomScale = 1.0;
    private double PanX = 0;
    private double PanY = 0;
    private const double MinZoom = 1.0;
    private const double MaxZoom = 8.0;

    private bool IsPanning = false;
    private bool IsDraggingRoad = false;
    private double LastPanX, LastPanY;

    private bool IsSimulationMode { get; set; } = false;
    private bool IsSimulating { get; set; } = false;
    private CancellationTokenSource SimulationTokenSource;
    private const int AnimationStepDelayMs = 360; 

    private List<RoadProgressState> ActiveRoadAnimations { get; set; } = new();

    private class RoadProgressState {
        public Road RoadRef { get; set; }
        public double Progress { get; set; } = 0.0;
        public bool IsInverted { get; set; } = false;
    }

    private async Task RunSearch() {
        if(string.IsNullOrEmpty(StartCity) || string.IsNullOrEmpty(TargetCity)) return;

        CancelActiveSimulation();

        SearchResult finalResult = null;
        if (SelectedAlgorithmKey == "ID_BIDS") {
            finalResult = IdBiDfsEngine.FindPath(StartCity, TargetCity);
            ActiveEngineName = IdBiDfsEngine.Name;
        } else if (SelectedAlgorithmKey == "ASTAR") {
            finalResult = AStarEngine.FindPath(StartCity, TargetCity);
            ActiveEngineName = AStarEngine.Name;
        }

        if (finalResult == null) return;

        if (IsSimulationMode) {
            await AnimateExplorationAsync(finalResult);
        } else {
            Result = finalResult;
        }
    }

    private async Task AnimateExplorationAsync(SearchResult completeResult) {
        IsSimulating = true;
        SimulationTokenSource = new CancellationTokenSource();
        var token = SimulationTokenSource.Token;

        Result = new SearchResult {
            Path = completeResult.Path,
            ExecutionTime = completeResult.ExecutionTime,
            TotalDistance = completeResult.TotalDistance,
            VisitedOrder = new List<string>()
        };
        ActiveRoadAnimations.Clear();

        try {
            if (completeResult.VisitedOrder.Count == 0) return;

            Result.VisitedOrder.Add(completeResult.VisitedOrder[0]);
            await InvokeAsync(StateHasChanged);

            int frameSubsteps = 12;
            int stepIntervalMs = AnimationStepDelayMs / frameSubsteps;

            for (int i = 1; i < completeResult.VisitedOrder.Count; i++) {
                token.ThrowIfCancellationRequested();
                string targetNode = completeResult.VisitedOrder[i];

                Road connectingRoad = null;
                string parentNode = null;

                foreach (var visitedNode in Result.VisitedOrder) {
                    connectingRoad = GeorgiaMap.Roads.FirstOrDefault(r =>
                        (r.StartCity == visitedNode && r.EndCity == targetNode) ||
                        (r.StartCity == targetNode && r.EndCity == visitedNode));

                    if (connectingRoad != null) {
                        parentNode = visitedNode;
                        break;
                    }
                }

                if (connectingRoad != null) {
                    var animState = new RoadProgressState {
                        RoadRef = connectingRoad,
                        Progress = 0.0,
                        IsInverted = connectingRoad.EndCity == parentNode
                    };
                    ActiveRoadAnimations.Add(animState);

                    for (int step = 1; step <= frameSubsteps; step++) {
                        token.ThrowIfCancellationRequested();
                        animState.Progress = (double)step / frameSubsteps;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(stepIntervalMs, token);
                    }
                } else {
                    await Task.Delay(AnimationStepDelayMs, token);
                }

                Result.VisitedOrder.Add(targetNode);
                await InvokeAsync(StateHasChanged);
            }

            if (completeResult.Path != null && completeResult.Path.Count >= 2) {
                string targetCityNode = completeResult.Path.Last();
                string priorCityNode = completeResult.Path[completeResult.Path.Count - 2];

                Road finalGreenRoad = GeorgiaMap.Roads.FirstOrDefault(r =>
                    (r.StartCity == priorCityNode && r.EndCity == targetCityNode) ||
                    (r.StartCity == targetCityNode && r.EndCity == priorCityNode));

                if (finalGreenRoad != null && !ActiveRoadAnimations.Any(a => a.RoadRef == finalGreenRoad)) {
                    token.ThrowIfCancellationRequested();

                    var finalAnimState = new RoadProgressState {
                        RoadRef = finalGreenRoad,
                        Progress = 0.0,
                        IsInverted = finalGreenRoad.EndCity == priorCityNode
                    };
                    ActiveRoadAnimations.Add(finalAnimState);

                    for (int step = 1; step <= frameSubsteps; step++) {
                        token.ThrowIfCancellationRequested();
                        finalAnimState.Progress = (double)step / frameSubsteps;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(stepIntervalMs, token);
                    }
                }
            }
        }
        catch (OperationCanceledException) {
        }
        finally {
            IsSimulating = false;
            SimulationTokenSource?.Dispose();
            SimulationTokenSource = null;
        }
    }

    private (double X, double Y) GetBezierPoint(double t, double x1, double y1, double cx, double cy, double x2, double y2) {
        double x = Math.Pow(1 - t, 2) * x1 + 2 * (1 - t) * t * cx + Math.Pow(t, 2) * x2;
        double y = Math.Pow(1 - t, 2) * y1 + 2 * (1 - t) * t * cy + Math.Pow(t, 2) * y2;
        return (x, y);
    }

    private double GetBezierPixelLength(double x1, double y1, double cx, double cy, double x2, double y2) {
        double length = 0;
        int segments = 12;
        double prevX = x1;
        double prevY = y1;

        for (int i = 1; i <= segments; i++) {
            double t = (double)i / segments;
            double currentX = Math.Pow(1 - t, 2) * x1 + 2 * (1 - t) * t * cx + Math.Pow(t, 2) * x2;
            double currentY = Math.Pow(1 - t, 2) * y1 + 2 * (1 - t) * t * cy + Math.Pow(t, 2) * y2;

            double dx = currentX - prevX;
            double dy = currentY - prevY;
            length += Math.Sqrt(dx * dx + dy * dy);

            prevX = currentX;
            prevY = currentY;
        }
        return length;
    }

    private void CancelActiveSimulation() {
        if (SimulationTokenSource != null) {
            SimulationTokenSource.Cancel();
            SimulationTokenSource.Dispose();
            SimulationTokenSource = null;
        }
        ActiveRoadAnimations.Clear();
        IsSimulating = false;
    }

    private void HandleWheel(WheelEventArgs e) {
        double zoomFactor = e.DeltaY < 0 ? 1.12 : 1.0 / 1.12;
        double newZoom = Math.Clamp(ZoomScale * zoomFactor, MinZoom, MaxZoom);
        if (newZoom == ZoomScale) return;

        double cursorSvgX = e.OffsetX;
        double cursorSvgY = e.OffsetY;

        PanX = cursorSvgX - (cursorSvgX - PanX) * (newZoom / ZoomScale);
        PanY = cursorSvgY - (cursorSvgY - PanY) * (newZoom / ZoomScale);
        ZoomScale = newZoom;

        ClampPan();
        StateHasChanged();
    }

    private void HandleMapPointerDown(PointerEventArgs e) {
        if (e.Button != 0 || IsDraggingRoad) return;
        IsPanning = true;
        LastPanX = e.ClientX;
        LastPanY = e.ClientY;
    }

    private void HandleMapPointerMove(PointerEventArgs e) {
        if (IsDraggingRoad) {
            HandlePointerMove(e);
            return;
        }

        if (!IsPanning) return;

        double dx = e.ClientX - LastPanX;
        double dy = e.ClientY - LastPanY;
        LastPanX = e.ClientX;
        LastPanY = e.ClientY;

        PanX += dx;
        PanY += dy;
        ClampPan();
        StateHasChanged();
    }

    private void HandleMapPointerUp(PointerEventArgs e) {
        IsPanning = false;
        if (IsDraggingRoad) {
            HandlePointerUp(e);
        }
    }

    private void HandleRoadHandleDown(PointerEventArgs e, Road road, City a, City b) {
        if (IsSimulating) return; 
        IsDraggingRoad = true;
        IsPanning = false;
        HandlePointerDown(e, road, a, b);
    }

    private void ClampPan() {
        double maxPanX = (ZoomScale - 1.0) * MapWidth;
        double maxPanY = (ZoomScale - 1.0) * MapHeight;
        PanX = Math.Clamp(PanX, -maxPanX, 0);
        PanY = Math.Clamp(PanY, -maxPanY, 0);
    }

    private (double X, double Y) Project(City city) {
        double pctX = (city.Lon - MinLon) / (MaxLon - MinLon);
        double pctY = 1.0 - ((city.Lat - MinLat) / (MaxLat - MinLat));

        return (pctX * MapWidth, pctY * MapHeight);
    }

    protected override void OnInitialized(){
        foreach(var road in GeorgiaMap.Roads){
            var cityA = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.StartCity);
            var cityB = GeorgiaMap.Cities.FirstOrDefault(c => c.Name == road.EndCity);

            if(cityA != null && cityB != null){
                var posA = Project(cityA);
                var posB = Project(cityB);

                road.ControlX = (posA.X + posB.X) / 2;
                road.ControlY = (posA.Y + posB.Y) / 2;

                road.RecalculateBezierDistance(posA.X, posA.Y, posB.X, posB.Y);
            }
        }
    }

    private void HandlePointerDown(PointerEventArgs eventArgs, Road road, City a, City b) {
        SelectedDraggingRoad = road;
        AssociatedCityA = a;
        AssociatedCityB = b;
    }

    private void HandlePointerMove(PointerEventArgs e) {
        if(SelectedDraggingRoad == null) {
            return;
        }

        double scaleFactorX = ((double)MapWidth / 1400.0) / ZoomScale;
        double scaleFactorY = ((double)MapHeight / 745.0) / ZoomScale;

        SelectedDraggingRoad.ControlX += (e.MovementX * scaleFactorX) * 2;
        SelectedDraggingRoad.ControlY += (e.MovementY * scaleFactorY) * 2;

        SelectedDraggingRoad.ControlX = Math.Clamp(SelectedDraggingRoad.ControlX, 0, MapWidth);
        SelectedDraggingRoad.ControlY = Math.Clamp(SelectedDraggingRoad.ControlY, 0, MapHeight);

        var posA = Project(AssociatedCityA);
        var posB = Project(AssociatedCityB);

        SelectedDraggingRoad.RecalculateBezierDistance(posA.X, posA.Y, posB.X, posB.Y);
    }

    private void HandlePointerUp(PointerEventArgs e) {
        SelectedDraggingRoad = null;
        AssociatedCityA = null;
        AssociatedCityB = null;
        IsDraggingRoad = false;
    }

    private bool IsRoadInPath(string city1, string city2) {
        if(Result == null || Result.Path == null || Result.Path.Count < 2) {
            return false;
        }

        for (int i = 0; i < Result.Path.Count - 1; i++) {
            string current = Result.Path[i];
            string next = Result.Path[i + 1];

            if ((current == city1 && next == city2) || (current == city2 && next == city1)) {
                return true;
            }
        }

        return false;
    }

    private bool IsRoadExploredDuringSimulation(string city1, string city2) {
        if (Result?.VisitedOrder == null) return false;
        return Result.VisitedOrder.Contains(city1) && Result.VisitedOrder.Contains(city2);
    }

    public void Dispose() {
        CancelActiveSimulation();
    }
}